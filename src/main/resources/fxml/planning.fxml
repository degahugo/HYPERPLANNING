<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #FFFFFF; -fx-background: #FFFFFF; -fx-border-color: transparent;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.hyperplanning.app.controllers.PlanningController">
    <content>
        <VBox spacing="35.0" style="-fx-padding: 45;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Emploi du temps" style="-fx-font-size: 38; -fx-font-weight: 900; -fx-text-fill: #111827;" />
                        <Label text="Consultez et filtrez le planning des cours." style="-fx-text-fill: #6B7280; -fx-font-size: 17;" />
                    </VBox>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button onAction="#onPrevWeek" prefHeight="45" text="‹Semaine Précédente" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-background-radius: 16; -fx-padding: 0 20; -fx-font-weight: 900; -fx-cursor: hand;" />
                        <Button onAction="#onNextWeek" prefHeight="45" text="Semaine Suivante›" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-background-radius: 16; -fx-padding: 0 20; -fx-font-weight: 900; -fx-cursor: hand;" />
                    </HBox>
                </HBox>

                <VBox alignment="CENTER" prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 30, 0, 0, 0); -fx-border-color: #F3F4F6; -fx-border-width: 1.5; -fx-border-radius: 25;">
                    <Label fx:id="weekLabel" style="-fx-font-size: 28; -fx-font-weight: 900;" text="Chargement..." />
                    <Label text="Planning Universitaire" style="-fx-text-fill: #9CA3AF; -fx-font-weight: bold;" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <HBox spacing="5.0" style="-fx-background-color: #F3F4F6; -fx-background-radius: 15; -fx-padding: 5;">
                        <Button fx:id="btnWeek" onAction="#onWeekView" prefHeight="40.0" prefWidth="120.0" text="Semaine" style="-fx-cursor: hand;"/>
                        <Button fx:id="btnDay" onAction="#onDayView" prefHeight="40.0" prefWidth="120.0" text="Jour" style="-fx-cursor: hand;"/>
                    </HBox>

                    <HBox fx:id="filterBar" alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                        <Separator orientation="VERTICAL" prefHeight="30.0" />

                        <ComboBox fx:id="comboPromo" onAction="#onPromotionChanged" prefHeight="40.0" prefWidth="180.0" promptText="Promotion" style="-fx-background-radius: 10;"/>

                        <ComboBox fx:id="comboGroupe" onAction="#onGroupeChanged" prefHeight="40.0" prefWidth="130.0" promptText="Groupe" style="-fx-background-radius: 10;"/>

                        <ComboBox fx:id="comboSalle" onAction="#onSalleChanged" prefHeight="40.0" prefWidth="130.0" promptText="Salle" style="-fx-background-radius: 10;"/>

                        <ComboBox fx:id="comboType" onAction="#onTypeChanged" prefHeight="40.0" prefWidth="100.0" promptText="Type" style="-fx-background-radius: 10;"/>

                        <Button onAction="#onResetFilters" prefHeight="40.0" prefWidth="80.0" text="Reset" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </HBox>

                <HBox fx:id="planningContainer" alignment="TOP_CENTER" fillHeight="true" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </content>
</ScrollPane>