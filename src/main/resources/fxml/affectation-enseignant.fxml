<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univ.hyperplanning.app.controllers.AffectationEnseignantController"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Affectation d'un ou plusieurs enseignants à un cours"/>

    <Label text="Choisir un cours :"/>
    <ComboBox fx:id="coursComboBox" prefWidth="400"/>

    <Label text="Choisir un ou plusieurs enseignants :"/>
    <ListView fx:id="enseignantsListView" prefHeight="250" prefWidth="400"/>

    <Button text="Enregistrer l'affectation" onAction="#handleEnregistrer"/>

    <Label fx:id="messageLabel" text=""/>
</VBox>