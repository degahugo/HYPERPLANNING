<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.univ.hyperplanning.app.controllers.SelectionEnseignantController">

    <Label text="Sélectionner un ou plusieurs enseignants" />

    <TableView fx:id="tableEnseignants" prefHeight="300" prefWidth="500">
        <columns>

            <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150"/>
            <TableColumn fx:id="colSpecialite" text="Spécialité" prefWidth="200"/>

        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Affecter au cours" onAction="#affecterEnseignant"/>
        <Button text="Annuler"/>
    </HBox>

</VBox>