<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.univ.hyperplanning.app.controllers.Authentification.ConnexionController"
            style="-fx-background-color: #7EADA8;">

    <!-- BOUTON S'INSCRIRE (haut droite) -->
    <top>
        <HBox alignment="CENTER_RIGHT">
            <padding><Insets top="12" right="12" bottom="0" left="0"/></padding>
            <Button text="S'inscrire" onAction="#ouvrirInscription"
                    style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 16;"/>
        </HBox>
    </top>

    <!-- FORMULAIRE CONNEXION -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20"
              style="-fx-background-color: #EAF4F2; -fx-background-radius: 6; -fx-padding: 40;"
              maxWidth="480">

            <Label text="Connexion"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

            <!-- Nom d'utilisateur -->
            <VBox spacing="4">
                <Label text="Nom d'utilisateur" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <TextField fx:id="fieldUsername" promptText="Nom d'utilisateur"
                           style="-fx-background-color: #F0D9C8; -fx-border-width: 0;
                                  -fx-font-size: 14px; -fx-padding: 12;"/>
            </VBox>

            <!-- Mot de passe -->
            <VBox spacing="4">
                <Label text="Mot de passe" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                <PasswordField fx:id="fieldPassword" promptText="Mot de passe"
                               style="-fx-background-color: #F0D9C8; -fx-border-width: 0;
                                      -fx-font-size: 14px; -fx-padding: 12;"/>
            </VBox>

            <!-- Mot de passe oublié -->
            <HBox alignment="CENTER_LEFT">
                <Button text="Mot de passe oublié ?" onAction="#ouvrirReinitialisationEmail"
                        style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;
                               -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 6 12;"/>
            </HBox>

            <!-- Message d'erreur -->
            <Label fx:id="labelErreur" text=""
                   style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"/>

            <!-- Bouton connexion -->
            <HBox alignment="CENTER">
                <Button fx:id="btnConnexion" text="Se connecter" onAction="#seConnecter"
                        style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;
                               -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10 28;"/>
            </HBox>

        </VBox>
    </center>

    <!-- PIED DE PAGE -->
    <bottom>
        <HBox style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;"
              alignment="CENTER_LEFT" spacing="0">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
            <Button text="Mentions légales" onAction="#ouvrirMentions"
                    style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-cursor: hand;"/>
            <Label text="" HBox.hgrow="ALWAYS"/>
            <Button text="Guide d'utilisation" onAction="#ouvrirGuide"
                    style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
