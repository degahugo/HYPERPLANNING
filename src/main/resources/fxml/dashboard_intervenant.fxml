<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F9FAFB; -fx-background: #F9FAFB; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.univ.hyperplanning.app.controllers.DashboardIntervenantController">
    <content>
        <VBox spacing="30" style="-fx-padding: 40;">

            <VBox spacing="8">
                <Label text="Espace Intervenant" style="-fx-font-size: 28; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                <Label text="Bienvenue ! Voici un aperçu de vos interventions." style="-fx-font-size: 14; -fx-text-fill: #6B7280;"/>
            </VBox>

            <HBox spacing="20">
                <VBox prefWidth="250" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label text="Interventions ce semestre" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                    <Label fx:id="totalCoursLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: 800;"/>
                </VBox>
                <VBox prefWidth="250" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label text="Ce mois" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                    <Label fx:id="coursMoisLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: 800;"/>
                </VBox>
                <VBox prefWidth="250" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label text="Aujourd'hui" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                    <Label fx:id="coursJourLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: 800;"/>
                </VBox>
            </HBox>

            <HBox>
                <Button text="Voir mon planning" onAction="#handleVoirToutPlanning"
                        style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-padding: 15 25; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Mes interventions aujourd'hui" style="-fx-font-size: 18; -fx-font-weight: 800;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Voir tout →" onAction="#handleVoirToutPlanning"
                            style="-fx-background-color: transparent; -fx-text-fill: #F59E0B; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
                <VBox fx:id="todayLessonsContainer" spacing="15"/>
            </VBox>

            <HBox spacing="20">
                <VBox fx:id="cardMesAbsences" prefWidth="250" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label text="Mes absences" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                    <Label fx:id="mesAbsencesCountLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: 800;"/>
                    <Label text="Suivre mes déclarations" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11;"/>
                </VBox>

                <VBox fx:id="cardAbsencesCours" prefWidth="250" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 16; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label text="Absences à consulter" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                    <Label fx:id="absencesCoursCountLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: 800;"/>
                    <Label text="Absences sur mes interventions" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11;"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
