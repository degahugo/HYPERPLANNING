<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univ.hyperplanning.app.controllers.MainController">

    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10;" spacing="20" alignment="CENTER_LEFT">
            <children>
                <Label text="Hyperplanning"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS" /> <Button text="🔍 Salles Disponibles"
                                                       onAction="#ouvrirRechercheSalles"
                                                       style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>

                <Button fx:id="btnDeconnexion"
                        text="🚪 Se déconnecter"
                        onAction="#seDeconnecter"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox fx:id="menuBox"
              spacing="10"
              style="-fx-background-color: #ecf0f1; -fx-padding: 15;"/>
    </left>

    <center>
        <AnchorPane fx:id="contentArea"/>
    </center>

</BorderPane>