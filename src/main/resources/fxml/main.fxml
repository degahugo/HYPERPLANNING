<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univ.hyperplanning.app.controllers.MainController">

    <left>
        <VBox spacing="20" style="-fx-background-color: #F5F6FA; -fx-padding: 20;" prefWidth="250">

            <VBox spacing="5">
                <Label text="HYPERPLANNING" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <Label text="Gestion Universitaire" style="-fx-text-fill: gray;"/>
            </VBox>

            <VBox fx:id="menuBox" spacing="10"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 10;">
                <Label text="👤" style="-fx-font-size: 18;"/>
                <VBox>
                    <Label fx:id="userNameLabel"/>
                    <Label fx:id="userInfoLabel" style="-fx-text-fill: gray;"/>
                </VBox>
            </HBox>

        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contentArea"/>
    </center>

</BorderPane>