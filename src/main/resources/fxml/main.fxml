<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univ.hyperplanning.app.controllers.MainController">
    <top>
        <HBox spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <children>
                <Label text="Hyperplanning" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Button text="🔍 Salles Disponibles"
                        onAction="#ouvrirRechercheSalles"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
            </children>
        </HBox>
    </top>

    <center>
        <fx:include source="planning.fxml"/>
    </center>

</BorderPane>