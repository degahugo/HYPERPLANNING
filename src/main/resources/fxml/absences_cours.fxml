<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fr.univ.hyperplanning.app.controllers.AbsencesCoursController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Absences sur mes cours"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

    <TableView fx:id="tableAbsences" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="140"/>
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="140"/>
            <TableColumn fx:id="colUtilisateurs" text="Utilisateurs" prefWidth="140"/>
            <TableColumn fx:id="colCours" text="Cours" prefWidth="180"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
            <TableColumn fx:id="colMotif" text="Motif" prefWidth="220"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>